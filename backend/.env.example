APP_ENV=production
APP_NAME=MareNostrum API

# Postgres (deve bater com docker-compose.yml)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=marenostrum
POSTGRES_USER=marenostrum
POSTGRES_PASSWORD=changeme

# JWT
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - libere apenas as ORIGENS (scheme+host, SEM path) que vao consumir a API.
# Sob subpath, a origem e o dominio principal (o /sistema NAO entra aqui).
CORS_ORIGINS=["https://marenostrumconsult.com.br","http://72.60.248.41","http://localhost:3000"]

# ---- Deploy sob subdiretorio /sistema (proxy reverso) ---------------------
# VAZIO = servido na raiz (padrao atual). Preencher SO no corte pra /sistema.
# ROOT_PATH: prefixo publico ate a app, SEM o /api interno (os routers ja
# registram sob /api). Ex.: /sistema  ->  Swagger em /sistema/api/docs.
ROOT_PATH=
# Base publica pros links do dossie PDF (rodape + QR). INCLUI o basePath.
PUBLIC_URL_BASE=https://srv1412083.hstgr.cloud
# No corte, trocar para:
# ROOT_PATH=/sistema
# PUBLIC_URL_BASE=https://marenostrumconsult.com.br/sistema

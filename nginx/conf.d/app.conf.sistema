# =============================================================================
# app.conf PARA O CORTE SOB /sistema  (substituição COMPLETA do app.conf atual)
# =============================================================================
# Copiar por cima do app.conf no corte:
#   cp nginx/conf.d/app.conf nginx/conf.d/app.conf.raiz.bak
#   cp nginx/conf.d/app.conf.sistema nginx/conf.d/app.conf
#   docker compose exec nginx nginx -t && docker compose restart nginx
#
# Arquitetura: /sistema é concern de BORDA.
#   - API  (/sistema/api/*) : TIRA o /sistema → container recebe /api/* nativo
#   - WEB  (/sistema/*)     : MANTÉM o /sistema (Next com basePath espera)
#   - raiz (/*)             : 301 → /sistema (compat: bookmarks antigos)
#   - warmup :8088 e cache : intocados (tráfego interno segue na raiz)
# =============================================================================

upstream mn_api  { server api:8000; keepalive 16; }
upstream mn_web  { server web:3000; keepalive 16; }

proxy_cache_path /var/cache/nginx/census levels=1:2 keys_zone=mn_census:10m
                 max_size=300m inactive=7d use_temp_path=off;
proxy_cache_path /var/cache/nginx/tse levels=1:2 keys_zone=mn_tse:10m
                 max_size=500m inactive=24h use_temp_path=off;

map $http_authorization $census_skip_cache {
    ""      1;
    default 0;
}

# Bucket do Accept-Encoding pra chave de cache: cada STRING de browser virava
# entrada própria (Chrome "…br, zstd" ≠ Firefox "…br" = 2x disco e 2x warmup;
# strings fora das aquecidas davam MISS). 3 buckets cobrem todo mundo.
map $http_accept_encoding $enc_bucket {
    default  "";
    ~*br     "br";
    ~*gzip   "gzip";
}

# HTTP — ACME + redirect pra HTTPS canônico.
server {
    listen 80;
    server_name srv1412083.hstgr.cloud 72.60.248.41 _;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type "text/plain";
    }
    location / { return 301 https://srv1412083.hstgr.cloud$request_uri; }
}

# Listener INTERNO de warmup (:8088) — NÃO muda. O warmup é tráfego interno e
# continua batendo em /api/v1/census/ na raiz (o /sistema é só borda pública).
server {
    listen 8088;
    server_name _;
    location /api/v1/census/ {
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_read_timeout 60s;
        proxy_cache        mn_census;
        proxy_cache_key    "$uri$is_args$args$enc_bucket";
        proxy_cache_valid  200 7d;
        # Igual ao bloco público: borda cacheia 7d, ignorando o max-age=900
        # do backend (o warmup nunca passa pelo ai-insight, que é no-store).
        proxy_ignore_headers Cache-Control Expires;
        proxy_no_cache     $census_skip_cache;
        proxy_cache_bypass $census_skip_cache;
        proxy_cache_lock      on;
        proxy_cache_use_stale updating error timeout;
        proxy_cache_background_update on;
        add_header         X-Cache-Status $upstream_cache_status;
    }
}

# HTTPS via IP → redirect canônico (cert não cobre IP).
server {
    listen 443 ssl;
    http2 on;
    server_name 72.60.248.41;
    ssl_certificate     /etc/letsencrypt/live/srv1412083.hstgr.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/srv1412083.hstgr.cloud/privkey.pem;
    return 301 https://srv1412083.hstgr.cloud$request_uri;
}

# HTTPS canônico — app servido sob /sistema.
server {
    listen 443 ssl;
    http2 on;
    server_name srv1412083.hstgr.cloud _;

    ssl_certificate     /etc/letsencrypt/live/srv1412083.hstgr.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/srv1412083.hstgr.cloud/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/conf.d/security-headers.inc;

    # ---- ai-insight: PRIVADO por tenant + no-store (anti-leak) --------------
    # Location EXATO ganha do prefixo /census/ e fica FORA do proxy_cache —
    # obrigatório porque o bloco de censo abaixo passou a IGNORAR o
    # Cache-Control do upstream (o no-store deste endpoint seria atropelado).
    location = /sistema/api/v1/census/ai-insight {
        rewrite ^/sistema/(.*)$ /$1 break;
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        include            /etc/nginx/conf.d/security-headers.inc;
    }

    # ---- CENSO sob /sistema : tira o /sistema + proxy_cache -----------------
    location /sistema/api/v1/census/ {
        rewrite ^/sistema/(.*)$ /$1 break;
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_cache        mn_census;
        proxy_cache_key    "$uri$is_args$args$enc_bucket";
        proxy_cache_valid  200 7d;
        # O backend manda max-age=900 (pro BROWSER); sem ignorar, esses 900s
        # também viravam o TTL da BORDA e o nginx re-agregava o censo a cada
        # 15min. Ignorando, vale o proxy_cache_valid 7d aqui (censo é estático
        # entre ingests) e o browser segue recebendo o max-age=900 original.
        proxy_ignore_headers Cache-Control Expires;
        proxy_no_cache     $census_skip_cache;
        proxy_cache_bypass $census_skip_cache;
        proxy_cache_lock      on;
        proxy_cache_use_stale updating error timeout;
        proxy_cache_background_update on;
        add_header         X-Cache-Status $upstream_cache_status;
        include            /etc/nginx/conf.d/security-headers.inc;
    }

    # ---- fotos TSE: público, chega via <img> SEM header Authorization -------
    # O bypass-por-falta-de-auth do bloco /tse/ abaixo anulava o cache
    # justamente no path mais requisitado do app (toda lista de candidatos
    # baixa dezenas de fotos). Foto é dado público → cacheia SEM bypass.
    # O Vary: Accept do backend separa as variantes webp/jpeg sozinho.
    location ~ ^/sistema/api/v1/tse/candidates/[0-9a-f-]+/photo$ {
        rewrite ^/sistema/(.*)$ /$1 break;
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_cache        mn_tse;
        proxy_cache_key    "$uri";
        proxy_cache_valid  200 7d;
        proxy_cache_valid  404 1h;
        proxy_cache_lock      on;
        proxy_cache_use_stale updating error timeout;
        add_header         X-Cache-Status $upstream_cache_status;
        include            /etc/nginx/conf.d/security-headers.inc;
    }

    # ---- TSE sob /sistema : tira o /sistema + honra Cache-Control -----------
    location /sistema/api/v1/tse/ {
        rewrite ^/sistema/(.*)$ /$1 break;
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_cache        mn_tse;
        proxy_cache_key    "$uri$is_args$args$enc_bucket";
        proxy_no_cache     $census_skip_cache;
        proxy_cache_bypass $census_skip_cache;
        proxy_cache_lock      on;
        proxy_cache_use_stale updating error timeout;
        proxy_cache_background_update on;
        add_header         X-Cache-Status $upstream_cache_status;
        include            /etc/nginx/conf.d/security-headers.inc;
    }

    # ---- resto da API sob /sistema (auth, contacts, docs, health) ----------
    location /sistema/api/ {
        rewrite ^/sistema/(.*)$ /$1 break;
        proxy_pass         http://mn_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- assets do Next sob /sistema : MANTÉM o prefixo (não reescrever) ----
    location /sistema/_next/static/ {
        proxy_pass         http://mn_web;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_hide_header  Cache-Control;
        add_header         Cache-Control "public, max-age=31536000, immutable";
        # Faz a EDGE da Vercel (que fica na frente via rewrite do site) cachear
        # os estáticos perto do usuário — sem isso era X-Vercel-Cache: MISS e
        # todo 1º load por região viajava até a VPS (~440ms num chunk de 172KB).
        add_header         Vercel-CDN-Cache-Control "public, max-age=31536000, immutable";
        include            /etc/nginx/conf.d/security-headers.inc;
    }
    location ~* ^/sistema/.*\.(png|jpe?g|gif|svg|ico|webp|avif|woff2?)$ {
        proxy_pass         http://mn_web;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_hide_header  Cache-Control;
        add_header         Cache-Control "public, max-age=2592000";
        include            /etc/nginx/conf.d/security-headers.inc;
    }

    # ---- app Next (páginas) sob /sistema : MANTÉM o prefixo ----------------
    location /sistema/ {
        proxy_pass         http://mn_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # /sistema sem barra → normaliza
    location = /sistema { return 308 /sistema/; }

    # ---- COMPAT: raiz e caminhos antigos → /sistema (bookmarks) ------------
    #      A app so responde sob /sistema (basePath); manda o resto pra la.
    location = / { return 301 /sistema/; }
    location / { return 301 /sistema$request_uri; }
}
